#!/usr/bin/env python3

import os
import sys

# fakejack lives in the parent directory, tests/fakes/
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from fakejack import disconnect

if len(sys.argv) != 3:
    sys.exit(1)

src, dst = sys.argv[1], sys.argv[2]
if not disconnect(src, dst):
    sys.exit(1)

sys.exit(0)
