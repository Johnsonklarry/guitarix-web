#!/usr/bin/env python3

import sys
import os

# fakejack lives in the parent directory, tests/fakes/
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from fakejack import connect, ports

if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.stderr.write("Usage: jack_connect SRC DST\n")
        sys.exit(1)

    src = sys.argv[1]
    dst = sys.argv[2]

    # Check if both ports exist
    all_ports = ports()
    if src not in all_ports:
        sys.stderr.write(f"jack_connect: port '{src}' does not exist\n")
        sys.exit(1)
    if dst not in all_ports:
        sys.stderr.write(f"jack_connect: port '{dst}' does not exist\n")
        sys.exit(1)

    # Try to connect
    if connect(src, dst):
        sys.exit(0)
    else:
        sys.exit(1)
