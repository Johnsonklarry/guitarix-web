#!/usr/bin/env python3

import os
import sys
import argparse

# Add the parent directory to the path so we can import fakejack
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from fakejack import ports, connections_of, connect, disconnect


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('-p', action='store_true')
    parser.add_argument('-c', type=str)
    args = parser.parse_args()

    if args.p:
        # List all ports with their properties
        for port, direction in sorted(ports().items()):
            print(port)
            print(f"    {direction}")
    elif args.c:
        # Show connections for a specific port
        port = args.c
        print(port)
        for connected_port in connections_of(port):
            print(f"    {connected_port}")
    else:
        # List port names only
        for port in sorted(ports()):
            print(port)


if __name__ == "__main__":
    main()
