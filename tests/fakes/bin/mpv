#!/usr/bin/env python3

import json
import os
import signal
import socket
import sys
import threading
import time
import wave

# Add the tests/fakes directory to the path so we can import fakejack
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import fakejack


# Global state
client_name = None
sock_path = None
pause_flag = False
loop_file = False
volume = 100

# Socket handling
sock = None
sock_lock = threading.Lock()


# Command handlers
def handle_command(cmd):
    global pause_flag, loop_file, volume
    request_id = cmd.get('request_id')
    command = cmd.get('command', [])
    
    if not command:
        return {'error': 'success', 'data': None, 'request_id': request_id}
    
    cmd_name = command[0]
    
    if cmd_name == 'set_property':
        prop = command[1]
        value = command[2]
        if prop == 'pause':
            pause_flag = bool(value)
        elif prop == 'volume':
            volume = max(0, min(100, int(value)))
        elif prop == 'loop-file':
            loop_file = (value == 'inf')
        return {'error': 'success', 'data': None, 'request_id': request_id}
    
    elif cmd_name == 'get_property':
        prop = command[1]
        if prop == 'pause':
            return {'error': 'success', 'data': pause_flag, 'request_id': request_id}
        elif prop == 'volume':
            return {'error': 'success', 'data': volume, 'request_id': request_id}
        elif prop == 'loop-file':
            return {'error': 'success', 'data': 'inf' if loop_file else 'no', 'request_id': request_id}
        elif prop == 'time-pos':
            return {'error': 'success', 'data': 0.0, 'request_id': request_id}
        elif prop == 'duration':
            return {'error': 'success', 'data': 0.0, 'request_id': request_id}
    
    elif cmd_name == 'seek':
        # We don't actually seek in this fake
        return {'error': 'success', 'data': None, 'request_id': request_id}
    
    elif cmd_name == 'quit':
        # Drop our ports before going. os._exit skips both the finally below
        # and the signal handlers, and player.py sends quit before it kills --
        # so without this the ports outlive the player and the guitar never
        # gets reconnected.
        if client_name:
            fakejack.remove_client(client_name)
        os._exit(0)
    
    return {'error': 'success', 'data': None, 'request_id': request_id}


def serve_socket():
    global sock
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.bind(sock_path)
        sock.listen(1)
        
        while True:
            conn, _ = sock.accept()
            with conn:
                while True:
                    data = conn.recv(4096)
                    if not data:
                        break
                    try:
                        lines = data.decode('utf-8').splitlines()
                        for line in lines:
                            if line.strip():
                                cmd = json.loads(line)
                                reply = handle_command(cmd)
                                conn.sendall((json.dumps(reply) + '\n').encode())
                    except Exception as e:
                        pass
    except Exception as e:
        pass


def main():
    global client_name, sock_path, pause_flag, loop_file
    
    # Parse arguments
    args = sys.argv[1:]
    
    try:
        for i, arg in enumerate(args):
            if arg.startswith('--jack-name='):
                client_name = arg[len('--jack-name='):]  
            elif arg == '--pause':
                pause_flag = True
            elif arg.startswith('--loop-file='):
                loop_file = (arg[len('--loop-file='):] == 'inf')
            elif arg.startswith('--input-ipc-server='):
                sock_path = arg[len('--input-ipc-server='):]  
            elif arg.startswith('--volume='):
                volume = max(0, min(100, int(arg[len('--volume='):])))
    except Exception as e:
        sys.exit(1)
    
    if not client_name or not sock_path:
        sys.exit(1)
    
    # Register output ports
    fakejack.add_ports({f'{client_name}:out_0': 'output', f'{client_name}:out_1': 'output'})
    
    # Start socket server in a thread
    if sock_path:
        try:
            os.unlink(sock_path)
        except OSError:
            pass
        
        socket_thread = threading.Thread(target=serve_socket, daemon=True)
        socket_thread.start()
    
    # Handle cleanup on exit
    def cleanup_handler(signum, frame):
        fakejack.remove_client(client_name)
        sys.exit(0)
    
    signal.signal(signal.SIGTERM, cleanup_handler)
    signal.signal(signal.SIGINT, cleanup_handler)
    
    try:
        # Get the file path (last argument)
        file_path = args[-1] if args else None
        
        if not file_path or not os.path.exists(file_path):
            sys.exit(1)
        
        # If it's a WAV file, get its duration
        duration = 0.0
        if file_path.endswith('.wav'):
            try:
                with wave.open(file_path, 'r') as wav_file:
                    frames = wav_file.getnframes()
                    rate = wav_file.getframerate()
                    duration = frames / float(rate)
            except Exception:
                pass
        
        # Play the file (sleep for its duration)
        while True:
            if not pause_flag:
                time.sleep(duration)
                if not loop_file:
                    break
            else:
                time.sleep(0.1)  # Sleep a bit when paused
    except Exception as e:
        pass
    finally:
        fakejack.remove_client(client_name)
        sys.exit(0)


if __name__ == '__main__':
    main()
