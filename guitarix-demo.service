# The demo-only copy: safe to port-forward. It serves the demo and nothing
# else -- recordings, uploads, the audio stream and the live connection are
# all refused, and it never contacts guitarix.
#
# It is the SAME app.py, with GX_DEMO_ONLY=1 set in the environment. There is
# deliberately no separate demo script: a forked copy drifts out of step with
# app.py and its demo-only guard is only as good as whoever last remembered to
# re-apply it.
#
#   sudo cp guitarix-demo.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now guitarix-demo
#
# Then forward port 5080 (not 5000) for friends.

[Unit]
Description=Guitarix web control surface (demo only)
After=network.target

[Service]
Type=simple
User=ljohnson
WorkingDirectory=/home/ljohnson/guitarix-web
ExecStart=/home/ljohnson/guitarix-web/.venv/bin/python /home/ljohnson/guitarix-web/app.py
Environment=GX_DEMO_ONLY=1
Environment=GX_WEB_PORT=5080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
